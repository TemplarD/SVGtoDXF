{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "SVG to DXF Converter",
  "version": "1.0.0",
  "identifier": "com.templard.svg2dxf",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "cd ui 2>/dev/null || cd ../crates/ui 2>/dev/null || cd crates/ui; trunk serve --port 1420",
    "beforeBuildCommand": "cd ui 2>/dev/null || cd ../crates/ui 2>/dev/null || cd crates/ui; trunk build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "SVG to DXF Converter",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": false,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/*", "$RESOURCE/*", "$APPCONFIG/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage", "nsis", "app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "SVG to DXF Converter",
    "longDescription": "Convert SVG files to DXF format. Supports geometry (paths, rect, circle, line, polygons), text (SVG text -> DXF MTEXT with font size and family), and raster images (PNG/JPEG/GIF traced to vector via marching squares)."
  },
  "plugins": {
    "log": {
      "category": "svg2dxf",
      "targets": ["log-dir"]
    },
    "fs": {
      "requireLiteralLeadingDot": false
    },
    "shell": {
      "open": true
    }
  }
}
